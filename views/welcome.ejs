<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Welcome - Magnificat Central Credit Cooperative</title>
    <link rel="stylesheet" href="/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/styles.css" />
    <!-- Google Fonts - Open Sans -->
    <link
      href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --bs-primary: #2b4593 !important; /* Change to your preferred color */
        --bs-primary-rgb: 255, 102, 0 !important; /* RGB equivalent */
      }

      /* Ensure Bootstrap buttons and text use the new primary color */
      .btn-primary {
        background-color: var(--bs-primary) !important;
        border-color: var(--bs-primary) !important;
      }
      body {
        font-family: "Open Sans", sans-serif !important;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        background-color: #f8f9fa;
      }
      .card {
        max-width: 600px;
        width: 100%;
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      }
      .logo {
        max-width: 150px;
        display: block;
        margin: 0 auto 15px;
      }
      .card-body {
        text-align: center;
      }
      .justified-text {
        text-align: justify;
      }
      .left-aligned-list {
        text-align: left;
      }
    </style>
  </head>
  <body>
    <% if (showInvalidRefModal) { %>
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        var modal = new bootstrap.Modal(
          document.getElementById("invalidRefModal")
        );
        modal.show();
      });
    </script>

    <!-- Bootstrap Modal -->
    <div
      class="modal fade"
      id="invalidRefModal"
      tabindex="-1"
      aria-labelledby="invalidRefModalLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header bg-danger text-white">
            <h5 class="modal-title" id="invalidRefModalLabel">
              Invalid Referral Code
            </h5>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
              aria-label="Close"
            ></button>
          </div>
          <div class="modal-body">
            Please let the person who gave you the link know that the referral
            code is invalid. The application will take you to the regular form
          </div>
          <div class="modal-footer">
            <a href="/" class="btn btn-primary">OK</a>
          </div>
        </div>
      </div>
    </div>
    <% } %>

    <div class="card">
      <div class="card-body">
        <img src="/images/mccc-reg-logo.png" alt="MCCC Logo" class="logo" />
        <h5 class="card-title">Welcome to the Registration Portal</h5>

        <p class="card-text justified-text">
          <strong
            >Please note, only Filipino Citizens who are 18 years old and above
            are eligible for an MCCC membership.</strong
          >
        </p>
        <!-- Membership Agreement Text -->
        <div class="mb-4">
          <p class="justified-text">
            I hereby apply for a membership with
            <strong>MAGNIFICAT CENTRAL CREDIT COOPERATIVE (MCCC)</strong>. I
            hereby agree to obey faithfully its rules and regulations as set
            down in its Articles of Incorporation and By-Laws, policies, and
            decisions of the general membership and those of the Board of
            Directors.
          </p>
          <p class="justified-text">
            <strong
              >For your consideration, I do hereby include my Personal
              Data.</strong
            >
          </p>
        </div>
        <form action="/start" method="POST">
          <button type="submit" class="btn btn-primary w-100 mt-3">
            Start Registration
          </button>
        </form>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
